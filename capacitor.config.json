{
  "appId": "com.flightwx.planner",
  "appName": "Flight Weather",
  "webDir": "www",
  "appendUserAgent": "FlightWxPlanner/1.0",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
